{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "jsx": "react",
    "noEmit": true,
    "paths": {
      "@deepseek-ai/cordis": [
        "../../node_modules/@deepseek-ai/cordis/lib/types/index.d.ts"
      ]
    }
  },
  "include": [
    "src/client.tsx",
    "src/model.ts",
    "src/locales.ts",
    "src/css.d.ts",
    "src/evidence.ts"
  ]
}
