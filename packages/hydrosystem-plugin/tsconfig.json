{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "lib",
    "skipLibCheck": true,
    "paths": {
      "@deepseek-ai/cordis": [
        "../../node_modules/@deepseek-ai/cordis/lib/types/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
