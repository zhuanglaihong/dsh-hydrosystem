{
  "name": "dsh-hydrosystem-workspace",
  "version": "0.1.0-alpha.8",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "pnpm run build:tools && pnpm run build:workspace",
    "typecheck": "tsc -p packages/hydrosystem-plugin/tsconfig.json --noEmit && tsc -p packages/hydro-workspace/tsconfig.host.json --noEmit && tsc -p packages/hydro-workspace/tsconfig.client.json",
    "test": "node --test tests/package.test.mjs tests/workspace.test.mjs tests/workspace-projection.test.mjs",
    "test:integration": "node --test tests/plugin.test.mjs tests/turn-policy.test.mjs",
    "test:python": "python -m unittest discover -s tests/python -v",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test",
    "prepare:core": "python scripts/prepare_core.py",
    "pack:plugin": "python scripts/pack_plugin.py",
    "build:tools": "tsc -p packages/hydrosystem-plugin/tsconfig.json",
    "build:workspace": "tsc -p packages/hydro-workspace/tsconfig.host.json && node scripts/build_workspace.mjs",
    "pack:tools": "python scripts/pack_plugin.py",
    "pack:workspace": "node -e \"require('node:fs').mkdirSync('artifacts', { recursive: true })\" && npm pack --ignore-scripts --json --pack-destination artifacts ./packages/hydro-workspace"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-jobs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@types/node": "24.10.0",
    "@types/react": "18.3.18",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  }
}
